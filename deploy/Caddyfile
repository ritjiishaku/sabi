# Sabi CMS — production reverse proxy (PRD §9, milestone 6)
#
# Production domain for Gift by VF. Caddy provisions and renews TLS
# automatically (Let's Encrypt). The Node app listens on 127.0.0.1:3000 and
# trusts the forwarded headers, so session cookies are marked Secure in prod.
#
#   caddy validate --config deploy/Caddyfile
#   caddy run --config deploy/Caddyfile
#   (systemd: install as /etc/caddy/Caddyfile and `systemctl reload caddy`)

cms.giftsbyvf.com {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	log {
		output file /var/log/caddy/sabi-cms.log
		format json
	}
}
