# Server
PORT=3000
DB_PATH=./data/cms.db
BRAND_NAME=Sabi CMS

# Turso (libSQL) — set BOTH to use a remote database instead of the local SQLite
# file above. Required on serverless hosts such as Vercel, where the filesystem
# is ephemeral. Create with: `turso db create sabi && turso db show sabi --url`
# and `turso db tokens create sabi`. When these are set, DB_PATH is ignored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Security — REQUIRED, no secrets in the repo
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HMAC_SECRET=

# Owner bootstrap account (created on first migrate; used for owner login)
OWNER_EMAIL=
OWNER_PASSWORD=

# Sheet import (public Google Sheet, gviz CSV export)
SHEET_ID=1N3_A0mPYkbTZ1ZeC3b_-KdrgV84jPRfyfYwEqzIwNB4
SHEET_SITE_SLUG=gifts-by-vf

# Backups (scripts/backup.mjs; see deploy/sabi-backup.timer for nightly schedule)
# Set a passphrase to encrypt snapshots with AES-256-GCM before they leave the box.
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_PASSPHRASE=
